+    patched["tpu_flexible"]["cost_per_gram_bdt"] = 999.0
+    monkeypatch.setattr("eo.mech_material.MATERIAL_PROPERTIES", patched)
+
+    strap = {"id": "strap_1", "name": "Wrist Strap", "category": "3D_PRINT",
