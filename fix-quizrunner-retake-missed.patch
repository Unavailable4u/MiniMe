@@ -151,7 +151,22 @@ export default function QuizRunner({ quizText, workspaceId, quizNodeId, topicId
     const missedSet = new Set(missed.map((m) => m.question));
     setMissedOnly(missedSet);
     setResult(null);
-    setAnswers({});
+    // BUGFIX: this used to also `setAnswers({})` here. submitAll() below
+    // always resubmits ALL `questions` (not just the visible/missed
+    // subset) — quiz_progress.grade_quiz() has no scoping concept, it
+    // grades the full parsed question list positionally against
+    // `answers`, full stop. Wiping every answer meant every question
+    // NOT in missedSet went into that resubmission as `null`
+    // (unanswered), which grades as wrong. Since get_missed_questions()
+    // keeps only each question's LATEST result, that "wrong" verdict for
+    // a question the user had already gotten right immediately re-added
+    // it to the missed list and tanked the reported score/percent for a
+    // pass that only ever touched the actually-missed questions — the
+    // opposite of what "Re-run missed only" promises. Keeping the prior
+    // answers in state means every question outside the current filter
+    // resubmits with its last (correct) answer unchanged; the user only
+    // overwrites the entries for the questions they're actually
+    // retaking, via choose() below.
     const firstMissed = questions.findIndex((qq) => missedSet.has(qq.question));
     setIndex(firstMissed >= 0 ? firstMissed : 0);
   }
