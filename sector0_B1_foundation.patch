+[pytest]
+# B3 (CI) runs: pytest tests/unit tests/integration -v
+# tests/manual is never collected by default — it hits real provider APIs
+# and real infra by design, and is meant to be run by hand or on a
+# nightly schedule, not on every push.
+testpaths = tests/unit tests/integration
+python_files = test_*.py
+python_classes = Test*
+python_functions = test_*
+markers =
+    manual: hits real external APIs, never run in CI (see tests/manual/)
