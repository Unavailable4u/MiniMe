+def test_add_member_inserts_and_resyncs_when_chat_id_is_owned(monkeypatch):
+    get_cursor_1 = FakeCursor(fetchone_results=[_batch_row(member_chat_ids=["chat_1"])])
+    owned_cursor = FakeCursor(fetchall_results=[[{"id": "chat_2"}]])
