# =============================================================================
# MiniMe Backend — Environment Variables
#
# =============================================================================

# Note for anyone auditing configs, writing eval/CI tooling, or otherwise
# reasoning about what's "actually set": this project's convention is
# that the real backend/.env is kept in lockstep with this file -- every
# key listed blank below (including UPSTASH_*, GROQ_*, etc.) has a real
# value in the real .env, not a placeholder. Don't flag a blank entry
# here as evidence that the corresponding real key is unset; this file
# is a name/shape reference, not a snapshot of what's actually
# configured. This does NOT extend to CI secrets (GitHub Actions
# secrets, e.g. .github/workflows/ci.yml's promptfoo job) -- those are a
# separate store from backend/.env entirely and must be added on their
# own, under the same var names, in the repo's Settings -> Secrets and
# variables -> Actions.


# -----------------------------------------------------------------------------
# App Config
# -----------------------------------------------------------------------------

# Runtime environment tag. Set to "production" / "staging" on real
# deployments so Sentry can filter events by environment.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the deployed frontend, used to build outbound links (e.g.
# integration-connect redirects). Defaults to http://localhost:3000 if unset.
FRONTEND_URL=http://localhost:3000

# Role-library scope tag. Only needed if running multiple isolated
# deployments off one shared role-prompt store. Defaults to "global".
# ROLE_LIBRARY_SCOPE=global


# -----------------------------------------------------------------------------
# Database & Auth — Supabase
# -----------------------------------------------------------------------------

SUPABASE_URL=

# Admin key — used for every backend Supabase call (api/deps.py). Bypasses
# RLS by design. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback JWT verification secret for legacy HS256 Supabase projects.
# Most current projects verify via SUPABASE_URL's JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# Not used by the backend — every Supabase call goes through
# SUPABASE_SERVICE_ROLE_KEY above. Belongs on the frontend
# (NEXT_PUBLIC_SUPABASE_ANON_KEY). Left here, unset, as a placeholder for a
# future RLS-scoped read path; safe to omit entirely otherwise.
# SUPABASE_ANON_KEY=

# Postgres connection string. Must be the minime_app role, not postgres —
# RLS is a no-op against postgres/table-owner connections (see migration
# 0003). Keep a separate admin connection string outside this file for
# running migrations.
DATABASE_URL=

# Connection pool sizing (eo/db.py). Defaults to 1/20 if unset. Raise
# DB_POOL_MAX for real concurrent load; bound it by your Postgres
# connection limit (Supabase's pooler has its own separate cap).
# DB_POOL_MIN=1
# DB_POOL_MAX=20


# -----------------------------------------------------------------------------
# LLM Provider — Groq
# Get keys from: https://console.groq.com/keys
# -----------------------------------------------------------------------------

# Primary pool: idea_planner, prompt_writer, test_writer, report_writer,
# gatekeeper, and other sequential low-volume roles.
GROQ_API_KEY=

# Reviewer Pool (3 parallel workers) — each needs its own account so
# simultaneous calls don't share a rate limit.
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=

# Structure Architect — isolated key, kept off the shared pool above to
# avoid queuing behind the Reviewer/Fixer Pool burst in the cycle.
GROQ_API_KEY_9=

# Additional GROQ_API_KEY-pool siblings (reinforces the primary pool above).
GROQ_API_KEY_10=
GROQ_API_KEY_11=
GROQ_API_KEY_12=
GROQ_API_KEY_13=
GROQ_API_KEY_14=

# Reviewer Pool reserves (used after GROQ_API_KEY_6/7/8 above).
GROQ_RESERVE_1=
GROQ_RESERVE_2=

# Starter General Agents (Layer 0).
SGA_GROQ_1=
SGA_GROQ_2=
SGA_GROQ_3=


# -----------------------------------------------------------------------------
# LLM Provider — Cerebras
# Get keys from: https://cloud.cerebras.ai/
# -----------------------------------------------------------------------------

# Code Writer Pool (5 parallel workers), Fixer Pool, Report Writer fallback.
# One key per slot; can start by reusing the same key across all 9,
# splitting later only if you hit rate limits.
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=
CEREBRAS_API_KEY_6=
CEREBRAS_API_KEY_7=
CEREBRAS_API_KEY_8=
CEREBRAS_API_KEY_9=

# Reserve pool for the above.
CEREBRAS_RESERVE_1=
CEREBRAS_RESERVE_2=
CEREBRAS_RESERVE_3=


# -----------------------------------------------------------------------------
# LLM Provider — Cloudflare Workers AI
# Get from: https://dash.cloudflare.com/ -> Workers AI -> Create API Token
# (Account / Workers AI / Edit). Account ID is on the dashboard home sidebar.
# Each slot below is its own Cloudflare account (Account ID + API Token).
# -----------------------------------------------------------------------------

# Dependency Mapper (slot 1), Reviewer fallback (slot 2), Fixer fallback
# (slot 3), Security Scanner Pool (slots 4-8, 5 parallel workers).
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_API_KEY_1=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_KEY_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_API_KEY_3=
CLOUDFLARE_ACCOUNT_ID_4=
CLOUDFLARE_API_KEY_4=
CLOUDFLARE_ACCOUNT_ID_5=
CLOUDFLARE_API_KEY_5=
CLOUDFLARE_ACCOUNT_ID_6=
CLOUDFLARE_API_KEY_6=
CLOUDFLARE_ACCOUNT_ID_7=
CLOUDFLARE_API_KEY_7=
CLOUDFLARE_ACCOUNT_ID_8=
CLOUDFLARE_API_KEY_8=

# Security Scanner reserve pool (3 slots). Token var names are derived at
# runtime from the account-ID var name (see
# agents/security_scanner.py:_token_env_for()) — both halves still need a
# real value below.
CF_SCANNER_RESERVE_1_ACCOUNT_ID=
CF_SCANNER_RESERVE_1_API_TOKEN=
CF_SCANNER_RESERVE_2_ACCOUNT_ID=
CF_SCANNER_RESERVE_2_API_TOKEN=
CF_SCANNER_RESERVE_3_ACCOUNT_ID=
CF_SCANNER_RESERVE_3_API_TOKEN=


# -----------------------------------------------------------------------------
# LLM Provider — Gemini
# Get keys from: https://aistudio.google.com/apikey
# Note: gemini-3.1-pro / gemini-2.5-pro are paid-only (0 free-tier quota) —
# never wire either into a free-tier key's chain. Use gemini-3.6-flash or
# gemini-3.1-flash-lite instead (see utils/llm_client.py's QUOTA_CONFIG).
# -----------------------------------------------------------------------------

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
GEMINI_API_KEY_13=
GEMINI_API_KEY_14=
GEMINI_API_KEY_15=
GEMINI_API_KEY_16=
GEMINI_API_KEY_17=
GEMINI_API_KEY_18=


# -----------------------------------------------------------------------------
# LLM Provider — Mistral
# Get keys from: https://console.mistral.ai/api-keys
# -----------------------------------------------------------------------------

# Documentation Agent, Final QA.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=
MISTRAL_API_KEY_6=
MISTRAL_API_KEY_7=
MISTRAL_API_KEY_8=
MISTRAL_API_KEY_9=
MISTRAL_API_KEY_10=


# -----------------------------------------------------------------------------
# LLM Provider — Hugging Face
# Get keys from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------

# Cross-Cycle Memory Search, Duplication Checker.
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEY_2=
HUGGINGFACE_API_KEY_3=
HUGGINGFACE_API_KEY_4=
HUGGINGFACE_API_KEY_5=

# Embeddings fallback (utils/embedding.py's HF_EMBEDDING_KEY_ENVS) — a
# separate pool from the chat/extraction keys above.
HUGGINGFACE_API_KEY_6=
HUGGINGFACE_API_KEY_7=
HUGGINGFACE_API_KEY_8=
HUGGINGFACE_API_KEY_9=
HUGGINGFACE_API_KEY_10=


# -----------------------------------------------------------------------------
# EO Layer — Inspector & Panel
# Dedicated, isolated accounts — separate from the production roster above
# so a busy tier-3 run never starves classification/triage for the next
# incoming task.
# -----------------------------------------------------------------------------

# Inspector + Responder (tier-0 triage). MUST be a fresh Groq account,
# distinct from GROQ_API_KEY. Get from: https://console.groq.com/keys
EO_INSPECTOR_GROQ_KEY_1=
# Optional second Groq account, used only if KEY_1 is rate-limited.
EO_INSPECTOR_GROQ_KEY_2=

# EO Panel Member B (primary). MUST be a dedicated Cerebras account.
# Get from: https://cloud.cerebras.ai/
EO_PANEL_CEREBRAS_KEY=

# EO Panel Member B (fallback). MUST be a dedicated Cloudflare account,
# separate from the production Cloudflare pool above.
# Get from: https://dash.cloudflare.com/ -> Workers AI
EO_PANEL_CLOUDFLARE_ACCOUNT_ID=
EO_PANEL_CLOUDFLARE_API_TOKEN=

# EO Panel Member C runs on MISTRAL_API_KEY_6/_7 and GEMINI_API_KEY_9 above
# — no dedicated keys needed here.


# -----------------------------------------------------------------------------
# Infrastructure — Upstash
# Get from: https://console.upstash.com/
# -----------------------------------------------------------------------------

# Primary Redis (memory/bus.py) — messaging bus + quota/usage tracking.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vector database — Cross-Cycle Memory Search, Duplication Checker.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Secondary Redis instance. Not read by any current code path — its
# original job (a separate quota-tracking system) was superseded by the
# primary Redis above. Kept provisioned for a future cache use case;
# do not reuse for quota tracking (see eo/quota_sentinel.py docstring).
UPSTASH_REDIS_CACHE_URL=
UPSTASH_REDIS_CACHE_TOKEN=


# -----------------------------------------------------------------------------
# Output Validation — Guardrails AI / Presidio
# See backend/eo/README-guardrails-presidio.md for the one-time setup steps
# (Guardrails Hub signup + `guardrails configure`, spaCy model download).
# -----------------------------------------------------------------------------

# Documented here for consistency with the other provider keys above, but note
# the Guardrails CLI stores its own token separately (in ~/.guardrailsai/),
# not read from this file by application code.
GUARDRAILS_API_KEY=


# -----------------------------------------------------------------------------
# Infrastructure — Other
# -----------------------------------------------------------------------------

# Sandbox Tester. Get from: https://e2b.dev/dashboard -> API Keys
E2B_API_KEY=

# Real-time relay (Channels app).
# Get all four from: https://dashboard.pusher.com/
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=


# -----------------------------------------------------------------------------
# Third-Party Integrations — Calendar / Gmail / Slack / Jira / Asana / Linear
# -----------------------------------------------------------------------------

# OAuth client. Get from: https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that same OAuth
# client, e.g. https://your-api-domain/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Fernet key encrypting every stored integration access/refresh token.
# Required before ANY integration (not just Google) can be stored or read.
# Standalone secret — do not reuse SUPABASE_JWT_SECRET/SERVICE_ROLE_KEY.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this later invalidates every stored token; every user must
# reconnect.
INTEGRATIONS_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Search Providers
# -----------------------------------------------------------------------------

TAVILY_API_KEY=
EXA_API_KEY=


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Get from: https://sentry.io/ -> your project -> Settings -> Client Keys.
# Leave blank to disable Sentry (safe default for local dev).
SENTRY_DSN=

# D1 — Langfuse. LLM call tracing (nested per-session traces of the
# Inspector -> Panel -> parallel worker pool run). Free-tier Cloud
# project: https://cloud.langfuse.com -> Settings -> API Keys.
# Region matters — a project created on the US region only works
# against LANGFUSE_BASE_URL=https://us.cloud.langfuse.com, not the EU
# default below.
# Leave both keys blank to disable tracing (safe default for local
# dev), same convention as SENTRY_DSN above. Unlike Sentry, nothing
# else needs to branch on this — the langfuse SDK falls back to an
# internal no-op client with no keys set, so eo/tracing.py's
# get_tracer() is safe to call unconditionally either way.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

#Got these by registering an app at developer.digikey.com for the Product Information V4 API (client-credentials/OAuth2 grant — no user login flow needed)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=