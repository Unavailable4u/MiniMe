+"""
+eo/data_handler.py — Patch C2 (MiniMe-Patch-Series-C-Plan.md, Track 2):
+the command-string front door onto eo/data_store.py.
+
+One function, run_data_command(session_id, command), is the only thing
+agents actually call. It looks like a command string because that's a
+compact, model-fluent format for an LLM to emit — not because anything
+resembling a real shell sits underneath it. Underneath, it's a small
+hand-written dispatcher over plain eo/data_store.py function calls; not
+click/argparse, since the only caller is a model, not a human at a
+prompt typing quoting edge cases and expecting --help text. Malformed
+input never raises past this function — it comes back as a short
+"error: ..." string, same "agent gets text back either way" contract
+run_data_command()'s own return type (str) implies, and the same
+"denial comes back as data, not an exception" posture
+eo/introspection.py's functions use for their own error case (see that
+module's docstring) — just returned as a formatted string here instead
+of a dict, since this function's whole job is producing text for a
+model's context window.
+
+Supported verbs:
+
+    list
+        -> data_store.list_sections(session_id), rendered as a table.
+
+    read <section_id>
+        -> data_store.read_section(session_id, section_id), returned
+        verbatim (no wrapping, so the agent gets exactly the section
+        text and nothing else).
+
+    search <pattern>
+        -> data_store.search_sections(session_id, pattern). Everything
+        after the verb, up to the end of the line, is the pattern
+        verbatim (not shell-tokenized) — a regex is far more likely to
+        contain literal spaces than a section_id is, and there's no
+        shell here for a caller to need to quote against.
+
+    write <section_id> <<<DELIM
+    ...text...
+    DELIM
+        -> data_store.write_section(session_id, section_id, text,
+        author_role). Heredoc-shaped so multi-line text (including
+        text containing quote characters) doesn't need any escaping
+        discipline from the caller. DELIM is any bare token with no
+        whitespace; the section text is every line between the header
+        line and the first later line that is exactly DELIM (that
+        closing line is not part of the text). author_role is a
+        required keyword argument on run_data_command itself (not part
+        of the command string) — see that function's own docstring for
+        why.
+
+    patch <section_id> --old ".." --new ".." [--v N]
+        -> data_store.patch_section(session_id, section_id, old, new,
+        expected_version=N or None). Single line, shell-quoted
+        (shlex rules) so --old/--new can contain spaces; --v is
+        optional and, when given, must parse as an int.
+
+Two cost regimes per the plan's own framing: every verb above is Mode
+C — deterministic, no LLM call, a thin pass-through to eo/data_store.py.
+Mode B (an LLM deciding which section is relevant before issuing a
+`read`) is a caller-side concern built on top of this function by
+whatever role prompt uses it — nothing in this module makes a model
+call itself.
+
+Does not go through eo/redaction_guard.py: task artifacts are not
+repo-filesystem secrets, so there's no readability gate to check here
+the way eo/introspection.py's functions check one. This module copies
+that module's byte/match caps instead (by way of data_store.py reusing
+eo/introspection.py's own MAX_READ_BYTES/MAX_SEARCH_MATCHES constants)
+so a role can't accidentally re-ingest an entire artifact just by
+asking a slightly broad question — see data_store.py's own docstring
+for where those caps are actually enforced.
+"""
+from __future__ import annotations
+
+import shlex
+
+from eo.data_store import VersionConflict
+from eo.data_store import list_sections as _list_sections
+from eo.data_store import patch_section as _patch_section
+from eo.data_store import read_section as _read_section
+from eo.data_store import search_sections as _search_sections
+from eo.data_store import write_section as _write_section
+
+_VERBS = ("list", "read", "search", "write", "patch")
+
+
+def _usage_error(detail: str) -> str:
+    return (
+        f"error: {detail} — supported verbs: "
+        "list | read <section_id> | search <pattern> | "
+        'write <section_id> <<<DELIM ... DELIM | '
+        'patch <section_id> --old ".." --new ".." [--v N]'
+    )
+
+
+def _format_sections(sections: list[dict]) -> str:
+    if not sections:
+        return "(no sections)"
+    lines = [
+        f"{s['section_id']}\twritten_by={s['written_by']}\t"
+        f"version={s['version']}\tbytes={s['byte_len']}"
+        for s in sections
+    ]
+    return "\n".join(lines)
+
+
+def _format_matches(matches: list[dict]) -> str:
+    if not matches:
+        return "(no matches)"
+    return "\n".join(f"{m['section_id']}: {m['match']}" for m in matches)
+
+
+def _format_entry(verb: str, entry: dict) -> str:
+    return (
+        f"{verb} ok: {entry['section_id']} "
+        f"(written_by={entry['written_by']}, version={entry['version']}, "
+        f"bytes={entry['byte_len']})"
+    )
+
+
+def _parse_write(session_id: str, head: str, rest_lines: list[str],
+                  author_role: str) -> str:
+    head_tokens = head.split()
+    if len(head_tokens) != 3 or not head_tokens[2].startswith("<<<"):
+        return _usage_error("write requires: write <section_id> <<<DELIM")
+    section_id = head_tokens[1]
+    delimiter = head_tokens[2][len("<<<"):]
+    if not delimiter:
+        return _usage_error("write's <<<DELIM marker needs a delimiter word")
+
+    text_lines: list[str] = []
+    closed = False
+    for line in rest_lines:
+        if line == delimiter:
+            closed = True
+            break
+        text_lines.append(line)
+    if not closed:
+        return _usage_error(
+            f"write's heredoc was never closed with a lone {delimiter!r} line"
+        )
+
+    if not author_role:
+        return _usage_error("write requires an author_role")
+
+    entry = _write_section(session_id, section_id, "\n".join(text_lines), author_role)
+    return _format_entry("write", entry)
+
+
+def _parse_patch(session_id: str, head: str) -> str:
+    try:
+        tokens = shlex.split(head)
+    except ValueError as exc:
+        return _usage_error(f"unbalanced quoting in patch command ({exc})")
+
+    # tokens[0] == "patch", tokens[1] == section_id
+    if len(tokens) < 2:
+        return _usage_error("patch requires a section_id")
+    section_id = tokens[1]
+    rest = tokens[2:]
+
+    old_snippet: str | None = None
+    new_snippet: str | None = None
+    expected_version: int | None = None
+
+    i = 0
+    while i < len(rest):
+        flag = rest[i]
+        if flag == "--old":
+            if i + 1 >= len(rest):
+                return _usage_error("--old requires a value")
+            old_snippet = rest[i + 1]
+            i += 2
+        elif flag == "--new":
+            if i + 1 >= len(rest):
+                return _usage_error("--new requires a value")
+            new_snippet = rest[i + 1]
+            i += 2
+        elif flag == "--v":
+            if i + 1 >= len(rest):
+                return _usage_error("--v requires a value")
+            try:
+                expected_version = int(rest[i + 1])
+            except ValueError:
+                return _usage_error(f"--v must be an integer, got {rest[i + 1]!r}")
+            i += 2
+        else:
+            return _usage_error(f"unrecognized patch flag {flag!r}")
+
+    if old_snippet is None or new_snippet is None:
+        return _usage_error("patch requires both --old and --new")
+
+    try:
+        entry = _patch_section(
+            session_id, section_id, old_snippet, new_snippet,
+            expected_version=expected_version,
+        )
+    except VersionConflict as exc:
+        return f"error: {exc}"
+    except ValueError as exc:
+        return f"error: {exc}"
+    return _format_entry("patch", entry)
+
+
+def run_data_command(session_id: str, command: str, author_role: str | None = None) -> str:
+    """Parse and dispatch a single command string against
+    eo/data_store.py for this session's artifact data. See this
+    module's own docstring for the full command grammar.
+
+    author_role is only consulted for the `write` verb (data_store's
+    write_section requires an author_role; patch_section does not,
+    since it preserves whichever role originally wrote the section) —
+    it's a keyword argument here rather than part of the command
+    string itself so a role can't spoof a different `written_by` just
+    by typing one into its command text.
+
+    Always returns a string, success or failure — never raises for a
+    malformed command or a data_store-level failure (missing section,
+    non-unique patch snippet, version conflict). This is deliberate:
+    the only caller is a model mid-conversation, and a raised exception
+    there is a dead end, not something it can act on the way it can act
+    on an "error: ..." string telling it what to try next.
+    """
+    if not session_id:
+        return "error: session_id is required"
+    if command is None or not command.strip():
+        return _usage_error("empty command")
+
+    lines = command.split("\n")
+    head = lines[0].strip()
+    if not head:
+        return _usage_error("empty command")
+
+    verb = head.split(maxsplit=1)[0]
+    if verb not in _VERBS:
+        return _usage_error(f"unknown verb {verb!r}")
+
+    if verb == "list":
+        if len(head.split()) != 1:
+            return _usage_error("list takes no arguments")
+        return _format_sections(_list_sections(session_id))
+
+    if verb == "read":
+        parts = head.split(maxsplit=1)
+        if len(parts) != 2 or not parts[1].strip():
+            return _usage_error("read requires a section_id")
+        section_id = parts[1].strip()
+        try:
+            return _read_section(session_id, section_id)
+        except KeyError as exc:
+            return f"error: {exc}"
+
+    if verb == "search":
+        parts = head.split(maxsplit=1)
+        if len(parts) != 2 or not parts[1].strip():
+            return _usage_error("search requires a pattern")
+        pattern = parts[1]
+        try:
+            return _format_matches(_search_sections(session_id, pattern))
+        except ValueError as exc:
+            return f"error: {exc}"
+
+    if verb == "write":
+        return _parse_write(session_id, head, lines[1:], author_role or "")
+
+    # verb == "patch"
+    return _parse_patch(session_id, head)
