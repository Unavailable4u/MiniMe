+"""
+m2c/tests/sandbox/test_sandbox_bwrap.py -- Patch C11a: finding bubblewrap and building the full command
+(``m2c.sandbox.bwrap``).  No bubblewrap is started: the binary is a file in ``tmp_path`` and the system
+directories come from a fake root, so these run on any machine.
+
+Run: cd m2c && pytest tests/sandbox/test_sandbox_bwrap.py -v
+"""
+from __future__ import annotations
+
+import os
+import stat
+from pathlib import Path
+
+import pytest
+
+from m2c.sandbox import bwrap
+from m2c.sandbox.bwrap import find_bwrap, find_shell, outer_environment, signal_from_exit_code, wrap_command
+from m2c.sandbox.profile import ProfileError, detect_system_layout
+
+from test_sandbox_profile import ENV, make_root  # tests/ has no packages: this sibling module is importable by name
+
+
+def make_exe(path: Path, text="#!/bin/sh\nexit 0\n") -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text)
+    path.chmod(0o755)
+    return path
+
+
+@pytest.fixture(autouse=True)
+def _no_system_fallback(monkeypatch):
+    """Isolate the PATH search from whatever bubblewrap this machine has."""
+    monkeypatch.setattr(bwrap, "_SAFE_PATH_FALLBACK", ())
+
+
+# ==========================================================================
+# finding bubblewrap
+# ==========================================================================
+def test_bwrap_is_found_in_an_absolute_path_entry(tmp_path):
+    exe = make_exe(tmp_path / "bin" / "bwrap")
+    assert find_bwrap(f"/nonexistent:{tmp_path / 'bin'}") == str(exe)
+
+
+def test_a_relative_path_entry_can_never_supply_bubblewrap(tmp_path, monkeypatch):
+    """The project directory is the model's workspace: a ``bwrap`` file there must never be what gets run."""
+    make_exe(tmp_path / "bwrap")
+    make_exe(tmp_path / "bin" / "bwrap")
+    monkeypatch.chdir(tmp_path)
+    for entry in (".", "", "bin", "./bin", "..", "~"):
+        assert find_bwrap(entry) is None, repr(entry)
+        assert find_bwrap(f"{entry}{os.pathsep}/nonexistent") is None, repr(entry)
+
+
+def test_a_file_that_is_not_executable_or_not_a_file_is_not_bubblewrap(tmp_path):
+    plain = tmp_path / "a" / "bwrap"
+    plain.parent.mkdir()
+    plain.write_text("x")
+    plain.chmod(0o644)
+    (tmp_path / "b" / "bwrap").mkdir(parents=True)
+    assert find_bwrap(f"{tmp_path / 'a'}:{tmp_path / 'b'}") is None
+
+
+def test_the_first_match_in_path_order_wins(tmp_path):
+    first = make_exe(tmp_path / "one" / "bwrap")
+    make_exe(tmp_path / "two" / "bwrap")
+    assert find_bwrap(f"{tmp_path / 'one'}:{tmp_path / 'two'}") == str(first)
+
+
+def test_no_path_means_not_found(monkeypatch):
+    monkeypatch.setenv("PATH", "")
+    assert find_bwrap() is None
+    assert find_bwrap("\x00bad") is None
+
+
+def test_the_usual_system_directories_are_tried_when_path_is_stripped(tmp_path, monkeypatch):
+    exe = make_exe(tmp_path / "usrbin" / "bwrap")
+    monkeypatch.setattr(bwrap, "_SAFE_PATH_FALLBACK", (str(tmp_path / "usrbin"),))
+    assert find_bwrap("") == str(exe)
+
+
+# ==========================================================================
+# the shell inside the sandbox
+# ==========================================================================
+def test_the_shell_is_bash_when_there_is_one_else_sh(tmp_path):
+    root = make_root(tmp_path)
+    assert find_shell(os.fspath(root)) == "/usr/bin/bash"
+    (root / "usr/bin/bash").unlink()
+    assert find_shell(os.fspath(root)) == "/usr/bin/sh"
+    (root / "usr/bin/sh").unlink()
+    assert find_shell(os.fspath(root)) is None
+
+
+def test_the_shell_path_is_absolute_and_inside_the_sandbox_layout(tmp_path):
+    root = make_root(tmp_path, merged_usr=False)
+    (root / "usr/bin/bash").unlink()
+    assert find_shell(os.fspath(root)) == "/bin/bash"
+
+
+# ==========================================================================
+# the full command
+# ==========================================================================
+@pytest.fixture
+def parts(tmp_path):
+    layout = detect_system_layout(os.fspath(make_root(tmp_path)))
+    exe = make_exe(tmp_path / "bin" / "bwrap")
+    home = tmp_path / "home"
+    project = home / "proj"
+    project.mkdir(parents=True)
+    return dict(layout=layout, bwrap_path=str(exe), project=os.path.realpath(project), home=os.path.realpath(home))
+
+
+def full(parts, command="echo hi", **kw):
+    return wrap_command(command, env=ENV, **{**parts, **kw})
+
+
+def test_the_command_is_bwrap_then_the_profile_then_double_dash_shell_dash_c_command(parts):
+    argv = full(parts, "echo hi")
+    assert argv[0] == parts["bwrap_path"]
+    i = argv.index("--")
+    assert argv[i:] == ["--", "/usr/bin/bash", "-c", "echo hi"]
+    assert argv[1:i][0] == "--unshare-user-try"
+
+
+def test_the_command_is_one_element_whatever_it_contains(parts):
+    for command in ("echo 'a b' && ls; rm -rf /", "-rf --unshare-all", "--help", "$(id)", "line1\nline2", " ", "é中"):
+        argv = full(parts, command)
+        assert argv[-1] == command and argv[-2] == "-c" and argv[-4] == "--"
+        assert argv.count(command) == 1 or command in ("--help",)
+
+
+def test_a_command_that_looks_like_an_option_cannot_become_one(parts):
+    argv = full(parts, "--share-net")
+    assert argv.index("--") < len(argv) - 1 and argv.index("--share-net") == len(argv) - 1
+    assert "--share-net" not in argv[:argv.index("--")]
+
+
+@pytest.mark.parametrize("bad", [5, None, b"x", ["echo"], "a\x00b"])
+def test_a_command_that_is_not_a_clean_string_is_refused(parts, bad):
+    with pytest.raises(ProfileError) as info:
+        full(parts, bad)
+    assert info.value.code == "command_invalid"
+
+
+def test_without_bubblewrap_there_is_no_command(parts, monkeypatch):
+    monkeypatch.setenv("PATH", "")
+    parts = {**parts, "bwrap_path": None}
+    with pytest.raises(ProfileError) as info:
+        full(parts)
+    assert info.value.code == "bwrap_missing"
+
+
+def test_without_a_shell_there_is_no_command(tmp_path):
+    root = make_root(tmp_path)
+    (root / "usr/bin/bash").unlink()
+    (root / "usr/bin/sh").unlink()
+    layout = detect_system_layout(os.fspath(root))
+    home = tmp_path / "home"
+    (home / "p").mkdir(parents=True)
+    with pytest.raises(ProfileError) as info:
+        wrap_command("x", project=os.path.realpath(home / "p"), home=os.path.realpath(home), env=ENV, layout=layout,
+                     bwrap_path=str(make_exe(tmp_path / "bwrap")))
+    assert info.value.code == "no_shell"
+
+
+def test_profile_errors_pass_through_with_their_fixed_text(parts):
+    with pytest.raises(ProfileError) as info:
+        full(parts, project="/mnt/c/Users/x/proj")
+    assert info.value.code == "project_on_windows_drive"
+
+
+def test_the_home_defaults_to_the_real_home(parts, monkeypatch):
+    monkeypatch.setenv("HOME", parts["home"])
+    argv = wrap_command("x", env=ENV, **{k: v for k, v in parts.items() if k != "home"})
+    assert ("--tmpfs", parts["home"]) in zip(argv, argv[1:])
+    assert bwrap.default_home() == parts["home"]
+
+
+def test_a_relative_or_missing_home_falls_back_to_the_passwd_entry(monkeypatch):
+    monkeypatch.setenv("HOME", "relative/home")
+    home = bwrap.default_home()
+    assert home is None or os.path.isabs(home)
+    monkeypatch.delenv("HOME")
+    home = bwrap.default_home()
+    assert home is None or os.path.isabs(home)
+
+
+def test_the_toolchain_extras_and_denied_lists_reach_the_profile(parts, tmp_path):
+    (Path(parts["home"]) / "tools").mkdir()
+    argv = full(parts, extra_ro=("tools",), toolchain_dirs=())
+    dest = f"{parts['home']}/tools"
+    assert any(argv[i] == "--ro-bind" and argv[i + 2] == dest for i in range(len(argv) - 2))
+    with pytest.raises(ProfileError):
+        full(parts, denied=(parts["project"],))
+
+
+def test_the_outer_environment_is_only_a_path():
+    env = outer_environment()
+    assert set(env) == {"PATH"} and all(os.path.isabs(d) for d in env["PATH"].split(":"))
+
+
+def test_nothing_is_created_or_started(parts, tmp_path):
+    before = sorted(str(p) for p in tmp_path.rglob("*"))
+    full(parts)
+    assert before == sorted(str(p) for p in tmp_path.rglob("*"))
+
+
+# ==========================================================================
+# exit statuses
+# ==========================================================================
+@pytest.mark.parametrize("code,sig", [(129, 1), (130, 2), (137, 9), (143, 15), (159, 31)])
+def test_an_exit_status_from_129_to_159_stands_for_a_signal(code, sig):
+    assert signal_from_exit_code(code) == sig
+
+
+@pytest.mark.parametrize("code", [None, 0, 1, 2, 127, 128, 160, 255, -9, True, False, "137", 137.0])
+def test_other_exit_statuses_are_not_signals(code):
+    assert signal_from_exit_code(code) is None
diff --git a/m2c/tests/sandbox/test_sandbox_doctor.py b/m2c/tests/sandbox/test_sandbox_doctor.py
new file mode 100644
index 0000000..ee1e5d1
--- /dev/null
+++ b/m2c/tests/sandbox/test_sandbox_doctor.py
@@ -0,0 +1,183 @@
+"""
+m2c/tests/sandbox/test_sandbox_doctor.py -- Patch C11a: what ``m2c doctor`` says about the sandbox.
+
+The doctor's bubblewrap line used to mean "the program is on PATH".  Now, when it is, the doctor runs the sandbox
+self-test and the line says the truth: ok (with how many checks passed), or a warning naming exactly which check failed
+or why the sandbox cannot be built.  These tests drive the check with fake probe results through ``Environment.
+sandbox_probe`` (no bubblewrap needed) and, where bubblewrap works, with the real one.
+
+Pinned: a sandbox that does not work is NEVER "ok"; a probe that crashes is not "ok" either; the line stays a warning
+(never a failure: m2c still runs without a sandbox, with its warning); the hints are specific; nothing in the text is a
+path of the throw-away world.
+
+Run: cd m2c && pytest tests/sandbox/test_sandbox_doctor.py -v -rs
+"""
+from __future__ import annotations
+
+import sys
+
+import pytest
+
+from m2c import doctor, sandbox
+from m2c.doctor import Status
+from m2c.sandbox.probe import CHECK_NAMES, REASONS, CheckOutcome, ProbeResult
+
+
+
+def result(report: doctor.Report, name_fragment: str) -> doctor.CheckResult:
+    """The one result whose name contains ``name_fragment`` (a local copy of tests/test_doctor.py's finder: importing
+    that module pulls in ``conftest`` by bare name, which resolves to tests/tools/conftest.py when only the sandbox
+    and tools tests are collected)."""
+    matches = [r for r in report.results if name_fragment.lower() in r.name.lower()]
+    assert len(matches) == 1, [r.name for r in report.results]
+    return matches[0]
+
+TOOLS = {"rg": "/usr/bin/rg", "git": "/usr/bin/git", "bwrap": "/usr/bin/bwrap"}
+
+
+def good() -> ProbeResult:
+    return ProbeResult(True, "ok", "the sandbox works", tuple(CheckOutcome(n, True, "ok") for n in CHECK_NAMES), "/usr/bin/bwrap", 100)
+
+
+def check_failed(*names: str) -> ProbeResult:
+    checks = tuple(CheckOutcome(n, n not in names, "ok" if n not in names else "violated") for n in CHECK_NAMES)
+    return ProbeResult(False, "check_failed", f"{REASONS['check_failed']}: {', '.join(names)}", checks, "/usr/bin/bwrap", 100)
+
+
+def cannot_start(code: str) -> ProbeResult:
+    return ProbeResult(False, code, REASONS[code], (CheckOutcome("basic", False, "setup_failed"),), "/usr/bin/bwrap", 10)
+
+
+def line(make_env, probe, **kw):
+    return result(doctor.run_doctor(env=make_env(tools=kw.pop("tools", TOOLS), sandbox_probe=probe, **kw)), "bubblewrap")
+
+
+# ==========================================================================
+# ok
+# ==========================================================================
+def test_a_working_sandbox_is_ok_and_says_how_many_checks_passed(make_env):
+    r = line(make_env, good)
+    assert r.status is Status.OK
+    assert "/usr/bin/bwrap" in r.detail and f"all {len(CHECK_NAMES)} sandbox checks passed" in r.detail
+
+
+def test_the_report_is_all_green_with_a_working_sandbox(make_env):
+    report = doctor.run_doctor(env=make_env(sandbox_probe=good))
+    text = report.render()
+    assert report.ok and "WARN" not in text and "FAIL" not in text and "All hard requirements are met" in text
+
+
+def test_the_line_keeps_its_name(make_env):
+    assert line(make_env, good).name == "bubblewrap (bwrap)"
+
+
+def test_without_a_probe_the_line_is_what_it_was_before(make_env):
+    r = result(doctor.run_doctor(env=make_env()), "bubblewrap")
+    assert r.status is Status.OK and r.detail == "/usr/bin/bwrap"
+
+
+# ==========================================================================
+# the truth when it does not work
+# ==========================================================================
+@pytest.mark.parametrize("failed", [("write_git",), ("network_unreachable",), ("write_outside_project", "cd_up_write")])
+def test_a_failed_check_is_a_warning_that_names_it(make_env, failed):
+    r = line(make_env, lambda: check_failed(*failed))
+    assert r.status is Status.WARN
+    assert "does not work" in r.detail
+    for name in failed:
+        assert name in r.detail
+    assert "without a sandbox" in r.detail, "the consequence is stated"
+
+
+@pytest.mark.parametrize("code", ["userns_unavailable", "proc_unavailable", "netns_unavailable", "bwrap_failed", "timeout"])
+def test_a_sandbox_that_cannot_start_says_why(make_env, code):
+    r = line(make_env, lambda: cannot_start(code))
+    assert r.status is Status.WARN and REASONS[code] in r.detail
+
+
+def test_user_namespace_trouble_comes_with_the_actual_fix(make_env):
+    r = line(make_env, lambda: cannot_start("userns_unavailable"))
+    assert "kernel.apparmor_restrict_unprivileged_userns=0" in r.hint and "unprivileged_userns_clone" in r.hint
+
+
+def test_other_reasons_get_their_own_or_a_generic_hint(make_env):
+    assert "/proc" in line(make_env, lambda: cannot_start("proc_unavailable")).hint
+    assert "namespace" in line(make_env, lambda: cannot_start("netns_unavailable")).hint
+    assert line(make_env, lambda: check_failed("write_git")).hint
+
+
+@pytest.mark.parametrize("probe", [
+    lambda: ProbeResult(False, "check_failed", "x", ()),
+    lambda: ProbeResult(False, "probe_error", REASONS["probe_error"]),
+    lambda: cannot_start("userns_unavailable"),
+    lambda: None,
+    lambda: object(),
+    lambda: "works",
+])
+def test_nothing_that_is_not_a_clean_pass_is_ever_ok(make_env, probe):
+    assert line(make_env, probe).status is Status.WARN
+
+
+def test_a_probe_that_crashes_is_a_warning_not_a_green_line(make_env):
+    def boom():
+        raise RuntimeError("secret detail " + "x" * 5)
+
+    r = line(make_env, boom)
+    assert r.status is Status.WARN and "could not be run" in r.detail and "secret detail" not in r.detail + r.hint
+
+
+def test_a_failing_sandbox_never_fails_the_doctor(make_env):
+    report = doctor.run_doctor(env=make_env(sandbox_probe=lambda: check_failed("write_git")))
+    assert report.ok, "warnings do not change the exit status"
+    assert "WARN" in report.render() and "write_git" in report.render()
+
+
+def test_no_bubblewrap_is_a_warning_and_the_probe_is_not_run(make_env):
+    called = []
+    r = line(make_env, lambda: called.append(1), tools={"rg": "/r", "git": "/g"})
+    assert r.status is Status.WARN and "not found" in r.detail and "no command sandbox" in r.detail
+    assert "apt install bubblewrap" in r.hint and called == []
+
+
+def test_the_text_contains_no_path_of_the_throw_away_world(make_env, tmp_path):
+    r = line(make_env, lambda: check_failed("write_git"))
+    for text in (r.detail, r.hint):
+        assert str(tmp_path) not in text and "m2c-probe-" not in text and "/var/tmp" not in text
+
+
+# ==========================================================================
+# wiring
+# ==========================================================================
+def test_the_real_environment_runs_a_fresh_probe_each_time(monkeypatch):
+    calls = []
+    fakes = [good(), check_failed("write_git")]
+    monkeypatch.setattr(sandbox, "fresh_probe", lambda **kw: calls.append(1) or fakes[len(calls) - 1])
+    env = doctor.Environment.detect()
+    assert env.sandbox_probe is not None
+    assert env.sandbox_probe().works is True and env.sandbox_probe().works is False and len(calls) == 2
+
+
+def test_the_doctor_does_not_use_the_cached_session_probe(monkeypatch):
+    monkeypatch.setattr(sandbox, "get_status", lambda **kw: pytest.fail("the doctor must look fresh, not at the cache"))
+    monkeypatch.setattr(sandbox, "fresh_probe", lambda **kw: good())
+    r = result(doctor.run_doctor(env=doctor.Environment.detect()), "bubblewrap")
+    assert r.status in (Status.OK, Status.WARN)
+
+
+def test_an_environment_built_by_hand_without_a_probe_still_works(make_env):
+    assert make_env().sandbox_probe is None
+
+
+# ==========================================================================
+# the real thing
+# ==========================================================================
+@pytest.mark.real_sandbox
+def test_the_real_doctor_reports_a_working_sandbox(make_env):
+    from m2c.sandbox import bwrap
+
+    if bwrap.find_bwrap() is None or not sandbox.fresh_probe().works:
+        reason = "bubblewrap is missing or does not work here"
+        sys.__stderr__.write(f"\nSKIPPED: real-sandbox doctor test: {reason}\n")
+        pytest.skip(reason)
+    r = line(make_env, sandbox.fresh_probe, tools={**TOOLS, "bwrap": bwrap.find_bwrap()})
+    assert r.status is Status.OK and "sandbox checks passed" in r.detail
diff --git a/m2c/tests/sandbox/test_sandbox_escape.py b/m2c/tests/sandbox/test_sandbox_escape.py
new file mode 100644
index 0000000..b2f42e3
--- /dev/null
+++ b/m2c/tests/sandbox/test_sandbox_escape.py
@@ -0,0 +1,584 @@
+"""
+m2c/tests/sandbox/test_sandbox_escape.py -- Patch C11a: real escape attempts against the real bubblewrap.
+
+Every test here runs a command through the shell tool in ``sandbox="required"`` mode (so a missing sandbox is an
+error, never an unsandboxed run) and checks TWO things, because a command can lie or fail quietly:
+what the command saw, and what is on the real disk or in the real process table afterwards.
+
+The world: a fake home (``$HOME`` is the suite's temporary home) with canaries in ``~/.ssh``, ``~/.aws``,
+``~/.config`` and ``~/.m2c``, a project inside it with ``.git``, ``.m2c`` and shell rc files, and an "outside"
+directory under ``/var/tmp`` that the sandbox does not mount.  Every canary is built at run time.
+
+These tests need bubblewrap and user namespaces.  When they are missing every test is SKIPPED with a loud
+"SKIPPED: <reason>" line on stderr (and the reason in pytest's -rs summary); nothing here silently passes.
+
+Run (Ubuntu / WSL2 Ubuntu):   sudo apt install bubblewrap && cd m2c && pytest tests/sandbox -v -rs
+
+What is NOT proved here, on purpose: bubblewrap itself and the kernel are trusted.  A kernel exploit, a
+vulnerable ``bwrap`` or a command that abuses the project directory (it IS writable) is outside this patch.
+"""
+from __future__ import annotations
+
+import os
+import secrets
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+from m2c import sandbox
+from m2c.tools import ToolContext, ToolError
+from m2c.tools.shell import AUTH_USER_APPROVED, ShellConfig, configure_shell, run_command
+
+pytestmark = [
+    pytest.mark.real_sandbox,
+    pytest.mark.skipif(not sys.platform.startswith("linux"), reason="the sandbox is Linux only"),
+]
+
+_STATUS: dict = {}
+RAN_BEGIN, RAN_END = "M2C_SCRIPT_BEGIN", "M2C_SCRIPT_END"
+
+
+def _loud_skip(reason: str) -> None:
+    sys.__stderr__.write(f"\nSKIPPED: real-sandbox escape tests: {reason}\n")
+    sys.__stderr__.flush()
+    pytest.skip(reason)
+
+
+@pytest.fixture(autouse=True)
+def need_sandbox():
+    if "result" not in _STATUS:
+        _STATUS["result"] = sandbox.fresh_probe()
+    result = _STATUS["result"]
+    if not result.works:
+        _loud_skip(result.describe())
+
+
+def token(prefix="m2c-canary") -> str:
+    return f"{prefix}-{secrets.token_hex(10)}"
+
+
+# ==========================================================================
+# the world
+# ==========================================================================
+class World:
+    def __init__(self, tmp_path: Path):
+        self.home = Path(os.environ["HOME"]).resolve()
+        self.project = self.home / "proj"
+        self.project.mkdir(parents=True)
+        self.canaries = {}
+        for rel in (".ssh/id_test", ".aws/credentials", ".config/tool/secret", ".m2c/state", ".bashrc", ".netrc"):
+            path = self.home / rel
+            path.parent.mkdir(parents=True, exist_ok=True)
+            self.canaries[rel] = token()
+            path.write_text(self.canaries[rel])
+        for rel in (".git/config", ".m2c/state", ".bashrc", ".profile", ".zshrc", "README.md"):
+            path = self.project / rel
+            path.parent.mkdir(parents=True, exist_ok=True)
+            self.canaries[f"proj/{rel}"] = token()
+            path.write_text(self.canaries[f"proj/{rel}"])
+        base = "/var/tmp" if os.path.isdir("/var/tmp") and os.access("/var/tmp", os.W_OK) else tempfile.gettempdir()
+        self.outside = Path(tempfile.mkdtemp(prefix="m2c-outside-", dir=base))
+        (self.outside / "keep").write_text(token())
+        self.context = self.new_context()
+
+    def new_context(self, **cfg) -> ToolContext:
+        context = ToolContext(self.project)
+        configure_shell(context, ShellConfig(sandbox="required", kill_grace_s=0.5, **cfg))
+        return context
+
+    def sh(self, command: str, timeout_s: int = 30, context=None, **kw):
+        return run_command(context or self.context, command, timeout_s, authorization=AUTH_USER_APPROVED, **kw)
+
+    def sh_ran(self, script: str, **kw):
+        """Like ``sh``, but the script is bracketed by markers and the result is only returned when BOTH were printed, so an
+        assertion that something is ABSENT from the output can never pass just because the script did not run."""
+        r = self.sh(f"echo {RAN_BEGIN}; {script}\necho {RAN_END}", **kw)
+        assert RAN_BEGIN in r.output and RAN_END in r.output, f"the script did not run to its end: {r.output}"
+        return r
+
+    def read(self, rel: str) -> str:
+        return (self.project / rel).read_text()
+
+    def assert_untouched(self, *rels):
+        for rel in rels:
+            assert self.read(rel) == self.canaries[f"proj/{rel}"], f"{rel} was changed"
+
+    def close(self):
+        shutil.rmtree(self.outside, ignore_errors=True)
+
+
+@pytest.fixture
+def w(tmp_path):
+    world = World(tmp_path)
+    yield world
+    world.close()
+
+
+def host_processes_with(needle: str) -> list[int]:
+    found = []
+    for entry in Path("/proc").iterdir():
+        if not entry.name.isdigit() or int(entry.name) == os.getpid():
+            continue
+        try:
+            if needle.encode() in (entry / "cmdline").read_bytes():
+                found.append(int(entry.name))
+        except OSError:
+            continue
+    return found
+
+
+def wait_gone(needle: str, seconds=5.0) -> bool:
+    end = time.monotonic() + seconds
+    while time.monotonic() < end:
+        if not [p for p in host_processes_with(needle) if _alive(p)]:
+            return True
+        time.sleep(0.05)
+    return False
+
+
+def _alive(pid: int) -> bool:
+    try:
+        stat = Path(f"/proc/{pid}/stat").read_text()
+    except OSError:
+        return False
+    return stat.rsplit(")", 1)[1].split()[0] not in ("Z", "X")
+
+
+# ==========================================================================
+# the shell tool works inside
+# ==========================================================================
+def test_a_normal_command_works_and_runs_inside_the_sandbox(w):
+    r = w.sh("echo hello; pwd; cat /proc/1/comm")
+    assert r.ok and "hello" in r.output and str(w.project) in r.output
+    assert "bwrap" in r.output, "PID 1 inside is bubblewrap: the command really runs in its own PID namespace"
+
+
+def test_the_project_is_writable_and_what_is_written_reaches_the_disk(w):
+    r = w.sh("echo new > created.txt && mkdir -p sub/dir && echo deep > sub/dir/f && echo changed > README.md && mv created.txt renamed.txt && rm sub/dir/f")
+    assert r.ok, r.output
+    assert (w.project / "renamed.txt").read_text() == "new\n" and not (w.project / "created.txt").exists()
+    assert (w.project / "sub" / "dir").is_dir() and not (w.project / "sub/dir/f").exists()
+    assert w.read("README.md") == "changed\n"
+    assert (w.project / "renamed.txt").stat().st_uid == os.getuid(), "files belong to the real user"
+
+
+def test_protected_files_can_still_be_read(w):
+    r = w.sh("cat .git/config; cat .m2c/state; cat .bashrc; ls .git")
+    assert r.ok
+    for rel in (".git/config", ".m2c/state", ".bashrc"):
+        assert w.canaries[f"proj/{rel}"] in r.output
+
+
+def test_the_system_toolchain_is_there_and_read_only(w):
+    r = w.sh("ls /usr/bin/env /bin/sh >/dev/null && echo tools-ok; touch /usr/bin/x 2>&1; echo rc=$?")
+    assert "tools-ok" in r.output and "rc=1" in r.output
+
+
+# ==========================================================================
+# writes outside the project
+# ==========================================================================
+def test_a_write_outside_the_project_fails_and_nothing_reaches_the_host(w):
+    targets = [w.outside / "pwned", w.home / "pwned", Path("/usr/pwned"), Path("/etc/pwned"), Path("/pwned"), w.project.parent / "pwned"]
+    script = "; ".join(f"echo x > {t} 2>/dev/null && echo WROTE:{i}" for i, t in enumerate(targets))
+    r = w.sh_ran(script + "; true")
+    assert "WROTE" not in r.output, r.output
+    assert not any(t.exists() for t in targets)
+    assert [p.name for p in w.outside.iterdir()] == ["keep"]
+
+
+def test_cd_up_then_write_fails(w):
+    r = w.sh_ran("cd .. && touch up-file 2>&1; echo rc1=$?; cd / && touch root-file 2>&1; echo rc2=$?; cd /usr && touch u 2>&1; echo rc3=$?")
+    assert "rc1=0" not in r.output and "rc2=0" not in r.output and "rc3=0" not in r.output, r.output
+    assert "Read-only file system" in r.output or "Permission denied" in r.output
+    assert not (w.home / "up-file").exists() and not Path("/root-file").exists()
+
+
+def test_the_home_directory_itself_is_read_only(w):
+    r = w.sh_ran("touch ~/newfile 2>&1; echo rc=$?; mkdir ~/newdir 2>&1; echo rc=$?; echo $HOME")
+    assert r.output.count("rc=") == 2 and r.output.count("rc=0") == 0
+    assert not (w.home / "newfile").exists() and not (w.home / "newdir").exists()
+
+
+def test_a_symlink_created_in_the_project_cannot_reach_outside(w):
+    r = w.sh(f"ln -s {w.outside} out && echo x > out/pwned 2>&1; echo rc=$?; ln -s {w.home}/.ssh ssh-link; cat ssh-link/id_test 2>&1; echo done")
+    assert "rc=0" not in r.output and w.canaries[".ssh/id_test"] not in r.output
+    assert not (w.outside / "pwned").exists()
+
+
+def test_a_symlink_that_was_already_in_the_project_cannot_reach_outside(w):
+    (w.project / "outlink").symlink_to(w.outside)
+    (w.project / "sshlink").symlink_to(w.home / ".ssh")
+    r = w.sh("echo x > outlink/pwned 2>&1; echo rc=$?; cat sshlink/id_test 2>&1; ls outlink 2>&1; echo done")
+    assert "rc=0" not in r.output and w.canaries[".ssh/id_test"] not in r.output
+    assert not (w.outside / "pwned").exists() and [p.name for p in w.outside.iterdir()] == ["keep"]
+
+
+def test_the_project_directory_itself_cannot_be_renamed_or_removed(w):
+    r = w.sh("cd / ; mv " + str(w.project) + " " + str(w.project) + "-moved 2>&1; echo rc=$?; rmdir " + str(w.project) + " 2>&1; echo rc=$?")
+    assert "rc=0" not in r.output and w.project.is_dir() and not Path(str(w.project) + "-moved").exists()
+
+
+# ==========================================================================
+# .git, .m2c and the shell rc files
+# ==========================================================================
+@pytest.mark.parametrize("name", [".git", ".m2c"])
+def test_protected_directories_cannot_be_changed_replaced_moved_or_removed(w, name):
+    target = ".git/config" if name == ".git" else ".m2c/state"
+    r = w.sh(
+        f"echo x > {name}/new 2>&1; echo a=$?; echo x >> {target} 2>&1; echo b=$?; "
+        f"mv {name} {name}.bak 2>&1; echo c=$?; rm -rf {name} 2>&1; echo d=$?; "
+        f"mkdir {name}/sub 2>&1; echo e=$?; ln -s /tmp {name}/link 2>&1; echo f=$?; rm {target} 2>&1; echo g=$?; true"
+    )
+    for letter in "abcdefg":
+        assert f"{letter}=0" not in r.output, f"{letter}: {r.output}"
+    assert (w.project / name).is_dir() and not (w.project / f"{name}.bak").exists()
+    assert w.read(target) == w.canaries[f"proj/{target}"]
+    assert sorted(p.name for p in (w.project / name).iterdir()) == sorted({".git": ["config"], ".m2c": ["state"]}[name])
+
+
+@pytest.mark.parametrize("name", [".bashrc", ".profile", ".zshrc"])
+def test_protected_rc_files_cannot_be_changed_replaced_or_removed(w, name):
+    r = w.sh(
+        f"echo 'evil' >> {name} 2>&1; echo a=$?; echo evil > {name} 2>&1; echo b=$?; rm -f {name} 2>&1; echo c=$?; "
