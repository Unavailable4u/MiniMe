+# ---------------------------------------------------------------------------
+# 6. _topics_to_ops
+# ---------------------------------------------------------------------------
+
+class TestTopicsToOps:
+    def test_single_top_level_topic_produces_one_add_op(self):
+        topics = [{
+            "name": "Motors", "summary": "about motors", "parent_name": None,
+            "source_section_ids": ["n1"], "content_hint": "conceptual",
+        }]
+        ops, topic_ids = source_manager._topics_to_ops(topics)
+        assert len(ops) == 1
+        assert len(topic_ids) == 1
+        op = ops[0]
+        assert op["op"] == "add"
+        assert op["path"] == f"/topics/{topic_ids[0]}"
+        assert op["value"]["name"] == "Motors"
+        assert op["value"]["parent"] is None
+        assert op["value"]["source_section_ids"] == ["n1"]
+        assert op["value"]["content_hint"] == "conceptual"
+
+    def test_child_topic_resolves_parent_id_from_same_batch(self):
+        topics = [
+            {"name": "Parent", "summary": "p", "parent_name": None,
+             "source_section_ids": [], "content_hint": "conceptual"},
+            {"name": "Child", "summary": "c", "parent_name": "Parent",
+             "source_section_ids": [], "content_hint": "conceptual"},
+        ]
+        ops, topic_ids = source_manager._topics_to_ops(topics)
+        parent_id = topic_ids[0]
+        child_op = ops[1]
+        assert child_op["value"]["parent"] == parent_id
+
+    def test_parent_name_matching_is_case_insensitive(self):
+        topics = [
+            {"name": "PARENT", "summary": "p", "parent_name": None,
+             "source_section_ids": [], "content_hint": "conceptual"},
+            {"name": "Child", "summary": "c", "parent_name": "parent",
+             "source_section_ids": [], "content_hint": "conceptual"},
+        ]
+        ops, topic_ids = source_manager._topics_to_ops(topics)
+        assert ops[1]["value"]["parent"] == topic_ids[0]
+
+    def test_unresolvable_parent_name_falls_back_to_top_level(self):
+        topics = [{
+            "name": "Orphan", "summary": "s", "parent_name": "Nonexistent Parent",
+            "source_section_ids": [], "content_hint": "conceptual",
+        }]
+        ops, _ = source_manager._topics_to_ops(topics)
+        assert ops[0]["value"]["parent"] is None
+
+    def test_returns_one_topic_id_per_topic_in_order(self):
+        topics = [
+            {"name": "A", "summary": "", "parent_name": None,
+             "source_section_ids": [], "content_hint": "conceptual"},
+            {"name": "B", "summary": "", "parent_name": None,
+             "source_section_ids": [], "content_hint": "conceptual"},
+        ]
+        _, topic_ids = source_manager._topics_to_ops(topics)
+        assert len(topic_ids) == 2
+        assert len(set(topic_ids)) == 2  # both unique uuids
+
+    def test_empty_topics_list_returns_empty_ops_and_ids(self):
+        ops, topic_ids = source_manager._topics_to_ops([])
+        assert ops == []
+        assert topic_ids == []
+
+    def test_never_resolves_parent_against_topic_outside_this_batch(self):
+        # single-source/single-chunk scoping: a parent_name that happens to
+        # match nothing in THIS batch falls back to top-level even if such
+        # a topic name could exist elsewhere in Secondary Data.
+        topics = [{
+            "name": "Solo", "summary": "s", "parent_name": "Some Other Source's Topic",
+            "source_section_ids": [], "content_hint": "conceptual",
+        }]
+        ops, _ = source_manager._topics_to_ops(topics)
+        assert ops[0]["value"]["parent"] is None
