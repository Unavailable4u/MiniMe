+def get_ledger_event_stats() -> dict:
+    """Perf audit follow-up (#5): the GLOBAL counterpart to
+    eo/quota_sentinel.get_ledger_event_counts()'s per-session view --
+    see _record_ledger_event()'s own docstring for why a second,
