+# ---------------------------------------------------------------------------
+# Patch F.4 (Phase F, Mech View standalone implementation guide) --
+# vibration-separation check: pure scan, no mutation, no I/O, no FreeCAD --
+# Part 1's own gap #4 ("nothing... keeps vibration-sensitive parts at a
+# safe distance from motors"). Literal Patch F.4 wording: "a check
+# distinct from plain collision (a 'too close' distance check, not a
+# 'touching' check)" -- deliberately NOT a bounding-box overlap/collision
+# test (that's validate_layout()'s own job above, via real FreeCAD
+# solids); this is a plain center-to-center Euclidean distance floor, same
+# "pure Python arithmetic, no FreeCAD" posture check_balance() above
+# already holds for its own distance-based (not collision-based) check.
+# ---------------------------------------------------------------------------
+
+# Minimum required center-to-center separation (mm) between a part
+# flagged eo/mech_thermal.py's own `vibration_source: True` (Patch F.1's
+# curated VIBRATION_TABLE) and any part matching
+# VIBRATION_SENSITIVE_KEYWORDS below. Kept as a small, clearly-labeled
+# module constant (not pulled from ENCLOSURE_SPEC, which has no
+# vibration-specific entry) -- same posture BALANCE_MARGIN_MM above
+# already takes for its own check-specific threshold.
+MIN_VIBRATION_SEPARATION_MM = 15.0
+
+# Substring keywords (matched against a normalized, lowercased
+# generic_name) identifying a vibration-SENSITIVE part -- literal Patch
+# F.4 worked-example vocabulary ("camera, IMU/gyro"). Same "curated
+# keyword substring scan, not a dedicated schema field" posture eo/
+# mech_balance.py's own GROUND_CONTACT_KEYWORDS already establishes,
+# since no part in this codebase carries an explicit
+# "vibration-sensitive" field of its own. "gyro" alone already covers
+# both a bare gyroscope and an IMU that names itself e.g. "6-axis
+# gyro/accel module" (substring match), same reasoning
+# GROUND_CONTACT_KEYWORDS's own "wheel" entry already documents for
+# itself toward "caster wheel".
+VIBRATION_SENSITIVE_KEYWORDS = ("camera", "imu", "gyro")
+
+
+def _normalize_generic_name(text) -> str:
+    """Case/whitespace-insensitive matching key -- same normalization
+    eo/mech_balance.py's own `_normalize()` (and eo/mech_thermal.py's own,
+    eo/mech_mass.py's own, eo/mech_motion.py's own) already use for the
+    identical reason, kept as this module's own private copy per this
+    tree's established "every module owns its own join/normalize helper"
+    precedent (eo/mech_swept_volume.py's own top docstring already states
+    this explicitly).
+    """
+    return " ".join((text or "").strip().lower().split())
+
+
+def _is_vibration_sensitive(generic_name) -> bool:
+    """True if `generic_name`'s own normalized form contains any of
+    `VIBRATION_SENSITIVE_KEYWORDS` above as a substring -- same
+    keyword-substring-scan posture eo/mech_balance.py's own
+    `_is_ground_contact()` already establishes for an analogous
+    "no dedicated schema field for this yet" part classification.
+    Never raises on a non-string/missing `generic_name`.
+    """
+    if not isinstance(generic_name, str):
+        return False
+    key = _normalize_generic_name(generic_name)
+    return any(keyword in key for keyword in VIBRATION_SENSITIVE_KEYWORDS)
+
+
+def _vibration_footprint_center(member: dict) -> tuple:
+    """A placed member's own footprint center, `(center_x, center_y,
+    center_z)` -- same "x"/"y"/"z"/"w"/"h"/"d" min-corner convention
+    every other placement/footprint helper in this tree already reads
+    (eo/mech_balance.py's own `_footprint_center()` is the identical
+    computation, one module over). Missing fields default to 0, same
+    "tolerant of a partial dict, never raises" posture this whole tree
+    holds itself to.
+    """
+    x = float(member.get("x") or 0) + float(member.get("w") or 0) / 2.0
+    y = float(member.get("y") or 0) + float(member.get("h") or 0) / 2.0
+    z = float(member.get("z") or 0) + float(member.get("d") or 0) / 2.0
+    return (x, y, z)
+
+
+def _joined_vibration_members(mech: dict, parts: list) -> list:
+    """Resolves every placement across EVERY section of `mech` into
+    member dicts, joined with its BOM part's own `generic_name` -- same
+    two-hop section->subsection->member resolution and "gate on the
+    data, not a hardcoded section list" posture every other `_joined_*()`
+    helper in this tree already establishes (eo/mech_balance.py's own
+    `_joined_mass_members()` is the closest sibling, one module over).
+
+    Returns a NEW list of shallow-copied member dicts -- never mutates
+    `mech["placements"]` or `parts`.
+    """
+    parts_by_id = {
+        p.get("id"): p for p in (parts or []) if isinstance(p, dict) and p.get("id")
+    }
+
+    joined = []
+    for section in (mech or {}).get("sections") or []:
+        if not isinstance(section, dict):
+            continue
+        from eo.mech_sections import subsections_for_section
+        for subsection in subsections_for_section(mech, section):
+            for member in members_for_subsection(mech, subsection):
+                if not isinstance(member, dict):
+                    continue
+                part = parts_by_id.get(member.get("part_id"))
+                merged = dict(member)
+                if isinstance(part, dict):
+                    merged["generic_name"] = part.get("generic_name")
+                joined.append(merged)
+    return joined
+
+
+def check_vibration_separation(mech: dict, parts: list) -> dict:
+    """Patch F.4 (Phase F, Mech View standalone implementation guide) --
+    verifies every part eo/mech_thermal.py's own `lookup_vibration()`
+    (Patch F.1) flags `True` sits at least `MIN_VIBRATION_SEPARATION_MM`
+    away (center-to-center) from every part matching
+    `VIBRATION_SENSITIVE_KEYWORDS` above -- Part 1's own gap #4.
+
+    Runs unconditionally (unlike `check_balance()` above, this is NOT
+    gated on `mech["archetype"]["mobility_type"]` -- a vibration source
+    sitting too close to a camera/IMU is a real risk on a static,
+    handheld, or wearable device just as much as a wheeled/legged one;
+    Phase F is itself explicitly "independent -- no dependency on Phase
+    A" per the guide's own suggested-apply-order table, so this check
+    never reads `mech["archetype"]` at all).
+
+    Deliberately calls ONLY `lookup_vibration()` (Patch F.1's free,
+    deterministic table lookup), NEVER `estimate_thermal_and_vibration()`
+    (Patch F.2's LLM fallback) -- same "keep the pure geometry function
+    pure, wire an actual LLM call in as a later, separately-reviewable
+    decision" posture `check_balance()` above already documents for
+    itself toward eo/mech_mass.py's own `estimate_mass()`. A part with no
+    curated VIBRATION_TABLE entry (`lookup_vibration()` returns `None`)
+    is treated as "not a known vibration source" for this check -- same
+    "unknown is not the same as a curated False, but neither one flags a
+    violation" reasoning eo/mech_cutouts.py's own Patch F.3 gate on
+    `lookup_thermal() == "hot"` already applies for its own `None`/`"none"`
+    distinction (both leave a part un-flagged either way).
+
+    Returns `{"ok": bool, "violations": [...], "pairs_checked": int}`.
+    A violation is a single dict: `{"vibration_source_part_id",
+    "sensitive_part_id", "separation_mm", "required_mm"}` -- the ACTUAL
+    (too-small) separation is always carried, not just a bare boolean, so
+    a caller/report can show how close is "too close" the same way
+    `check_balance()`'s own `"clearance_mm"` already does for its own
+    violation shape. `"pairs_checked"` is the total number of
+    vibration-source/sensitive-part pairs actually compared, so a caller
+    can distinguish "ok because nothing violated" from "ok because there
+    was nothing to check" (e.g. a device with no camera/IMU at all,
+    or no vibration source at all) without a separate `"skipped"` flag --
+    unlike `check_balance()`'s all-or-nothing archetype gate, this check
+    always evaluates SOME subset of parts against another, so "zero pairs"
+    is itself informative, not a distinct skip state.
+
+    Empty/not-yet-placed input (`mech` with no sections) returns
+    `{"ok": True, "violations": [], "pairs_checked": 0}` cleanly, no
+    error, same fail-safe posture every other "not ready yet" branch in
+    this module already holds.
+
+    Pure function: never mutates `mech` or `parts`.
+    """
+    if not isinstance(mech, dict) or not mech.get("sections"):
+        return {"ok": True, "violations": [], "pairs_checked": 0}
+
+    from eo.mech_thermal import lookup_vibration
+
+    members = _joined_vibration_members(mech, parts)
+
+    sources = [m for m in members if lookup_vibration(m.get("generic_name")) is True]
+    sensitive = [m for m in members if _is_vibration_sensitive(m.get("generic_name"))]
+
+    violations = []
+    pairs_checked = 0
+    for source in sources:
+        source_id = source.get("part_id")
+        source_center = _vibration_footprint_center(source)
+        for target in sensitive:
+            target_id = target.get("part_id")
+            if target_id == source_id:
+                continue  # a part can't be "too close" to itself
+            pairs_checked += 1
+            target_center = _vibration_footprint_center(target)
+            separation_mm = round(math.dist(source_center, target_center), 3)
+            if separation_mm < MIN_VIBRATION_SEPARATION_MM:
+                violations.append({
+                    "vibration_source_part_id": source_id,
+                    "sensitive_part_id": target_id,
+                    "separation_mm": separation_mm,
+                    "required_mm": MIN_VIBRATION_SEPARATION_MM,
+                })
+
+    return {"ok": not violations, "violations": violations, "pairs_checked": pairs_checked}
+
+
