+// Smallest circle that just encloses this group's CURRENT live x/y
+// (centroid + furthest-member distance, not a true minimum-enclosing
+// circle -- good enough for a soft halo and cheap to recompute every
+// animation frame while the simulation is still moving nodes).
+function enclosingCircle(members) {
+  const pts = members.filter((n) => typeof n.x === "number" && typeof n.y === "number");
+  if (pts.length < 2) return null;
+  const cx = pts.reduce((s, p) => s + p.x, 0) / pts.length;
+  const cy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
+  const radius = Math.max(...pts.map((p) => Math.hypot(p.x - cx, p.y - cy)));
+  return { cx, cy, radius };
+}
