+// NEW — cluster halos: low-opacity circles painted behind the graph,
+// one per "related group" of nodes, so relatedness reads as a shaded
+// territory in addition to the existing edge lines. Deliberately
+// derived from the SAME edges the force layout itself uses (closed
+// neighborhoods -- a node plus its direct neighbors), not a separate
+// embedding-based clustering like note_clusterer.py's KMeans pass:
+// KMeans hands every node to exactly one cluster, so its circles could
+// never overlap and could also disagree with where the physics has
+// actually settled the nodes. Edge-neighborhoods overlap naturally
+// (a node bridging two neighborhoods sits inside both circles), which
+// is what gives the set/subset look, and they stay visually honest
+// with the node-link layout since both are reading the same edges.
+const MAX_CLUSTER_CIRCLES = 8; // cap so a dense graph doesn't become a wall of color
+const CLUSTER_PADDING = 26; // px beyond the outermost member, clears node radius + label
+const CLUSTER_ALPHA = 0.13;
+const CLUSTER_PALETTE = [
+  "#f97316", "#06b6d4", "#eab308", "#ec4899",
+  "#8b5cf6", "#10b981", "#ef4444", "#3b82f6",
+];
+
+// Every node with >=2 neighbors becomes a candidate group (itself + its
+// direct neighbors). A group fully contained in a bigger one is dropped
+// (a hub's own neighborhood already covers each neighbor's smaller one),
+// and duplicate membership sets collapse to one. What's left is sorted
+// biggest-first and capped at MAX_CLUSTER_CIRCLES.
+function buildClusterGroups(graphNodes, neighbors) {
+  let candidates = [];
+  for (const node of graphNodes) {
+    const nbrs = neighbors.get(node.id) || [];
+    if (nbrs.length < 2) continue; // need self + >=2 neighbors for a meaningful circle
+    const members = new Map([[node.id, node]]);
+    for (const { node: n } of nbrs) members.set(n.id, n);
+    candidates.push(members);
+  }
+
+  candidates = candidates.filter(
+    (c, i) => !candidates.some((other, j) => i !== j && other.size > c.size && [...c.keys()].every((id) => other.has(id)))
+  );
+
+  const seenKeys = new Set();
+  candidates = candidates.filter((c) => {
+    const key = [...c.keys()].sort().join("|");
+    if (seenKeys.has(key)) return false;
+    seenKeys.add(key);
+    return true;
+  });
+
+  candidates.sort((a, b) => b.size - a.size);
+  return candidates.slice(0, MAX_CLUSTER_CIRCLES).map((c) => [...c.values()]);
+}
