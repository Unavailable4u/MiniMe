# =============================================================================
# MiniMe Local Daemon — Environment Variables
#
# Copy this file to daemon/.env and fill in real values. The repo's
# .gitignore already has a blanket ".env" rule that covers this path —
# never commit your real pairing token.
# =============================================================================

# Shared secret the daemon presents to the backend during the pairing
# handshake (wired in Part 2). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# or:
#   python -m daemon.config --generate-token
MINIME_PAIRING_TOKEN=

# The one folder on this machine the daemon is allowed to touch --
# every tool call (list_dir/read_file in Part 3, write_file/delete/
# execute_command in Part 4) is confined here. Use an absolute path to
# a specific project folder, not your home directory or "/".
# Example: /Users/you/projects/soil-monitor
MINIME_ALLOWED_ROOT=

# NEW — Part 2. Where the daemon connects OUT to (the daemon always
# dials the backend, never the other way around -- see
# eo/local_workspace.py's docstring for why). Must start with ws:// or
# wss://, no trailing slash and no path -- the daemon appends
# /ws/daemon/{MINIME_WORKSPACE_ID} itself.
# Local dev example: ws://localhost:8000
MINIME_BACKEND_WS_URL=

# NEW — Part 2. Which workspace this daemon instance pairs as -- the
# backend's session registry (eo/local_workspace.py) is keyed by this
# id, and it's how Part 3/4's tool calls know which live daemon
# connection to route a request to. Must match a real workspace_id in
# the backend (see /api/workspaces).
MINIME_WORKSPACE_ID=

# =============================================================================
# NEW — W7.4. Preview proxy (OPTIONAL). Leave MINIME_PREVIEW_TARGET empty and
# none of this is used.
#
# With it on, the daemon also listens on http://127.0.0.1:<MINIME_PREVIEW_PORT>
# and forwards to your dev server, stripping the headers that stop it being
# embedded in MiniMe's preview and injecting the inspector script -- so you can
# paste that address into the preview's "Dev server URL" box without editing
# your app. (Mapping a clicked element to a source line still needs
# @locator/babel-jsx or similar in your build; see the preview's "Set up
# click-to-code" panel.)
# =============================================================================

# Your own dev server. Must be on this machine (localhost, 127.0.0.1 or
# [::1]); just scheme://host:port, no path. The scheme is optional (http).
# Example: http://localhost:5173
MINIME_PREVIEW_TARGET=

# Where MiniMe's web app runs -- the page the preview is embedded in. The
# injected script is loaded from here and only ever talks to this origin.
# Required when MINIME_PREVIEW_TARGET is set.
# Local dev example: http://localhost:3000
MINIME_FRONTEND_ORIGIN=

# Port the proxy listens on (127.0.0.1 only). Optional, default 5199. Keep it
# fixed: MiniMe remembers the URL you typed per workspace.
MINIME_PREVIEW_PORT=
