# =============================================================================
# MiniMe Local Daemon — Environment Variables
#
# Copy this file to daemon/.env and fill in real values. The repo's
# .gitignore already has a blanket ".env" rule that covers this path —
# never commit your real pairing token.
# =============================================================================

# Shared secret the daemon presents to the backend during the pairing
# handshake (wired in Part 2). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# or:
#   python -m daemon.config --generate-token
MINIME_PAIRING_TOKEN=

# The one folder on this machine the daemon is allowed to touch --
# every tool call (list_dir/read_file in Part 3, write_file/delete/
# execute_command in Part 4) is confined here. Use an absolute path to
# a specific project folder, not your home directory or "/".
# Example: /Users/you/projects/soil-monitor
MINIME_ALLOWED_ROOT=
