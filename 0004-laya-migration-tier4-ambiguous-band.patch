+    counts = {name: laya_gate.read_counter(_OVERLAP_COUNTER_PREFIX + name)
+              for name in _OVERLAP_COUNTERS}
+    would = counts["would_skip"]
+    counts["skip_precision"] = (1.0 - counts["would_skip_wrong"] / would) if would else None
+    return counts
