+def _tag_reply(tag, probs=None):
+    probs = probs or {"new": 0.0, "duplicate": 0.0, "merge": 0.0}
+    probs[tag] = max(probs.get(tag, 0.0), 0.01)
+    return {"answers": {"tag": {"type": "choice", "choice": tag, "probabilities": probs}}}
