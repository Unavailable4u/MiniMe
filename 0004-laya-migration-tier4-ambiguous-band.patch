+            "outcome_b": laya_gate.clip(str(b.get("outcome") or ""), 300, "head"),
+        }
+        result = laya_gate.predict(state, _CONTRADICTION_QUESTION,
+                                    site="contradiction_prefilter.screen_pair")
+        if result is None:
