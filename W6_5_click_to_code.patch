+assertEqual([elShifted.refs[0].from, elShifted.refs[0].to, elShifted.refs[0].fromLine, elShifted.refs[0].toLine], [35, 95, 5, 8], "REMAP_REFS shifts an element chip with the edit, same as a range chip");
