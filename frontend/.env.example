# =============================================================================
# MiniMe frontend -- Environment Variables

# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Base URL the frontend uses to reach the backend API.
# Falls back to http://localhost:8000 if unset (fine for local dev).
# docker-compose overrides this to http://backend:8000 for the containerized
# frontend service so it can reach the backend by Docker network name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Supabase (auth + data)
# -----------------------------------------------------------------------------

# Get from: https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Pusher (realtime / websocket notifications)
# -----------------------------------------------------------------------------

# Get from: https://dashboard.pusher.com/ -> your app -> App Keys
# Both required together -- if either is missing, getPusherClient() returns
# null and realtime features quietly no-op.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

#  feature flag for tool-calling in chat. Default OFF -- classifyIntent()
# still runs and logs either way, but nothing acts on its result until this is
# set to "1".
NEXT_PUBLIC_CHAT_TOOL_CALLING_ENABLED=0

# -----------------------------------------------------------------------------
# Observability (B4 -- Sentry)
# -----------------------------------------------------------------------------
# Get from: https://sentry.io/ -> your project -> Settings -> Client Keys (DSN)
# Must be NEXT_PUBLIC_-prefixed to be readable in the browser bundle.
# Leave blank to disable Sentry entirely (safe default for local dev).
NEXT_PUBLIC_SENTRY_DSN=

# Tags client-side events with this environment name (server/edge configs
# read the backend's own ENVIRONMENT var directly). Set to
# "production"/"staging" etc. on real deployments.
NEXT_PUBLIC_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Observability (D1 -- Langfuse trace deep link)
# -----------------------------------------------------------------------------
# From: https://us.cloud.langfuse.com -> your project -> Settings -> General
# (the id in the project's own dashboard URL). Read once at module scope by
# TracesPanel.jsx, not per-request. Leave blank to disable the "View trace
# in Langfuse" link entirely -- same convention NEXT_PUBLIC_SENTRY_DSN above
# already uses.
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=

# Must match backend/.env.example's LANGFUSE_BASE_URL (same project, same
# region) or the link 404s. Defaults to US cloud if unset, same default
# backend/.env.example documents.
NEXT_PUBLIC_LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# -----------------------------------------------------------------------------
# Sentry build-time source map upload (optional, CI only)
# -----------------------------------------------------------------------------
# Not read at runtime -- only used by withSentryConfig during `next build`
# to upload source maps so stack traces resolve to real file/line numbers.
# Leave unset locally; builds succeed without them.
SENTRY_ORG=
SENTRY_PROJECT=minime-frontend
SENTRY_AUTH_TOKEN=
