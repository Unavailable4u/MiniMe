index 0000000..cee1795
--- /dev/null
+++ b/frontend/.env.example
@@ -0,0 +1,28 @@
+# =============================================================================
+# MiniMe frontend -- Environment Variables
+# Copy this file to .env.local and fill in real values.
+# =============================================================================
+
+# -----------------------------------------------------------------------------
+# Observability (B4 -- Sentry)
+# -----------------------------------------------------------------------------
+
+# Get from: https://sentry.io/ -> your project -> Settings -> Client Keys (DSN)
+# Must be NEXT_PUBLIC_-prefixed to be readable in the browser bundle.
+# Leave blank to disable Sentry entirely (safe default for local dev).
+NEXT_PUBLIC_SENTRY_DSN=
+
+# Tags client-side events with this environment name (server/edge configs
+# read the backend's own ENVIRONMENT var directly). Set to
+# "production"/"staging" etc. on real deployments.
+NEXT_PUBLIC_ENVIRONMENT=development
+
+# -----------------------------------------------------------------------------
+# Sentry build-time source map upload (optional, CI only)
+# -----------------------------------------------------------------------------
+# Not read at runtime -- only used by withSentryConfig during `next build`
+# to upload source maps so stack traces resolve to real file/line numbers.
+# Leave unset locally; builds succeed without them.
+# SENTRY_ORG=
+# SENTRY_PROJECT=
+# SENTRY_AUTH_TOKEN=
diff --git a/frontend/app/global-error.jsx b/frontend/app/global-error.jsx
new file mode 100644
index 0000000..25e3e47
--- /dev/null
+++ b/frontend/app/global-error.jsx
@@ -0,0 +1,25 @@
+"use client";
+
+// App Router doesn't route render errors through sentry.client.config.js
+// automatically -- this boundary is the documented way to catch them.
+// https://docs.sentry.io/platforms/javascript/guides/nextjs/manual-setup/#react-render-errors-in-app-router
+
+import * as Sentry from "@sentry/nextjs";
+import { useEffect } from "react";
+
+export default function GlobalError({ error, reset }) {
+  useEffect(() => {
+    Sentry.captureException(error);
+  }, [error]);
+
+  return (
+    <html>
+      <body>
+        <div style={{ padding: "2rem", textAlign: "center" }}>
+          <h2>Something went wrong.</h2>
+          <button onClick={() => reset()}>Try again</button>
+        </div>
+      </body>
+    </html>
+  );
+}
diff --git a/frontend/instrumentation.js b/frontend/instrumentation.js
new file mode 100644
index 0000000..851c780
--- /dev/null
+++ b/frontend/instrumentation.js
@@ -0,0 +1,16 @@
+// Next.js instrumentation hook (stable since Next 13.4, no config flag
+// needed). This is what actually loads sentry.server.config.js and
+// sentry.edge.config.js — without it those two files are inert.
+// sentry.client.config.js does NOT go through here; withSentryConfig's
+// webpack plugin injects that one into the client bundle directly.
+// https://docs.sentry.io/platforms/javascript/guides/nextjs/manual-setup/
+
+export async function register() {
+  if (process.env.NEXT_RUNTIME === "nodejs") {
+    await import("./sentry.server.config");
+  }
+
+  if (process.env.NEXT_RUNTIME === "edge") {
+    await import("./sentry.edge.config");
+  }
+}
