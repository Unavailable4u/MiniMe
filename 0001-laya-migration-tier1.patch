+def test_check_content_safety_fails_open_on_unexpected_result_shape(monkeypatch):
+    monkeypatch.setattr(output_guard.laya_gate, "predict", lambda *a, **k: {"answers": {}})
+    assert output_guard.check_content_safety("hello") == (True, "")
